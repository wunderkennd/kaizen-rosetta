package compilecheck

import (
	"testing"

	audiencev1 "github.com/wunderkennd/kaizen-rosetta/gen/go/kaizen/audience/v1"
	workbenchv1 "github.com/wunderkennd/kaizen-rosetta/gen/go/workbench/v1"
	workbenchv1connect "github.com/wunderkennd/kaizen-rosetta/gen/go/workbench/v1/workbenchv1connect"
)

var _ = &workbenchv1.SearchTitlesRequest{
	Query: "fullmetal",
	Scope: workbenchv1.SearchScope_SEARCH_SCOPE_TITLE,
	Limit: 20,
}

var _ workbenchv1connect.WorkbenchSearchServiceClient

func TestTypedAudienceSmoke(t *testing.T) {
	value := &audiencev1.AudienceValue{
		Kind: &audiencev1.AudienceValue_StringValue{StringValue: "premium"},
	}
	attribute := &audiencev1.AudienceAttribute{
		Value: value,
		Provenance: audiencev1.AudienceAttributeProvenance_AUDIENCE_ATTRIBUTE_PROVENANCE_OBSERVED,
	}
	context := &audiencev1.AudienceContext{
		Attributes: map[string]*audiencev1.AudienceAttribute{"subscription_tier": attribute},
		RegistryVersion: "2026-07-12",
	}
	if context.Attributes["subscription_tier"].GetValue().GetStringValue() != "premium" {
		t.Fatal("typed audience smoke lost its value")
	}
}
